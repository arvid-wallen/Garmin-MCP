# Garmin Connect Personal API key (https://connect.garmin.com/app/settings/personalApiToken).
GARMIN_PERSONAL_API_KEY=

# Time zone used to resolve "today" and relative dates.
GARMIN_TIMEZONE=Europe/Stockholm

# --- Remote (HTTP) mode only ------------------------------------------------
# Signs every OAuth artifact. At least 32 chars: openssl rand -hex 32
AUTH_SECRET=
# Password you type on the consent page when connecting Claude. At least 12 chars.
OWNER_PASSWORD=
# Public origin of the deployment. Auto-detected on Vercel/Railway; set it when using a custom domain.
PUBLIC_URL=
# Bump to revoke every issued token.
TOKEN_VERSION=1

# Optional
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# EXTRA_REDIRECT_URIS=https://example.com/callback
# GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com   # .cn for China accounts
# GARMIN_TIMEOUT_MS=30000
